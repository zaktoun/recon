// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Reconnaissance Target - Domain/IP yang akan di-scan
model ReconTarget {
  id          String   @id @default(cuid())
  target      String   // domain, IP, atau URL
  targetType  String   // "domain", "ip", "url"
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  tasks       ReconTask[]
}

// Reconnaissance Task - Scan session
model ReconTask {
  id          String        @id @default(cuid())
  targetId    String
  target      ReconTarget   @relation(fields: [targetId], references: [id], onDelete: Cascade)
  taskType    String        // "subdomain", "port", "service", "full_scan"
  status      String        @default("pending") // "pending", "running", "completed", "failed"
  progress    Int           @default(0) // 0-100
  startedAt   DateTime?
  completedAt DateTime?
  error       String?
  results     ReconResult[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([targetId])
  @@index([status])
}

// Reconnaissance Results - Hasil scan
model ReconResult {
  id          String   @id @default(cuid())
  taskId      String
  task        ReconTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  resultType  String   // "subdomain", "port", "service", "vulnerability", "dns_record"
  data        String   // JSON string untuk flexibel data structure
  severity    String?  // "critical", "high", "medium", "low", "info"
  isVerified  Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([taskId])
  @@index([resultType])
}